{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "spotify-organiser-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Client ID Metadata Documents make the Worker fetch client-supplied URLs; this keeps those fetches public.
	"compatibility_flags": ["global_fetch_strictly_public"],
	// Version preview URLs are other origins, and OAuth tokens only validate on the origin that issued them.
	"preview_urls": false,
	"observability": { "enabled": true },
	// No id: `wrangler deploy` creates the namespace on first deploy and reuses it after that.
	"kv_namespaces": [{ "binding": "OAUTH_KV" }],
	"vars": {
		// Spotify Organiser's Spotify app. Its dashboard must list `<worker origin>/callback` as a redirect URI.
		"SPOTIFY_CLIENT_ID": "4a3ae815c2a0443c824541a7aa94cfcc"
	},
	// Spotify only accepts loopback redirect URIs written as an IP, so local dev runs on 127.0.0.1.
	"dev": { "ip": "127.0.0.1", "port": 8787 }
}
