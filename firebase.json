{
	"hosting": {
		"public": "dist",
		"rewrites": [
			{
				"source": "!/@(static)/**",
				"destination": "/index.html"
			}
		],
		"headers": [
			{
				"source": "/static/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "max-age=31536000"
					}
				]
			},
			{
				"source": "/sw.js",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			}
		]
	},
	"database": {
		"rules": "database.rules.json"
	}
}
