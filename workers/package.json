{
	"name": "spotify-organiser-workers",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler pages dev --ip 127.0.0.1 --port 8788",
		"deploy": "wrangler pages deploy",
		"db:migrate": "wrangler d1 migrations apply spotify-organiser --local",
		"db:migrate:remote": "wrangler d1 migrations apply spotify-organiser --remote",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"test": "vitest run"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@cloudflare/workers-oauth-provider": "^1.2.3",
		"@hono/trpc-server": "^0.4.2",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@trpc/server": "^11.19.0",
		"hono": "^4.13.13",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261010.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.6",
		"wrangler": "^4.149.0"
	}
}
