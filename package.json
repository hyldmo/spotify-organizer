{
	"name": "spotify-organiser",
	"repository": "https://github.com/hyldmo/spotify-organizer",
	"version": "0.0.0-development",
	"scripts": {
		"dev": "webpack serve --config webpack/webpack.development.config.ts",
		"prod": "webpack --config webpack/webpack.production.config.ts --progress",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cover": "vitest run --coverage",
		"lint": "eslint src webpack",
		"stylelint": "stylelint 'src/**/*.scss'",
		"format": "prettier --write . --ignore-path .gitignore",
		"format:check": "prettier --check . --ignore-path .gitignore",
		"release": "semantic-release --config ./release.config.js",
		"prepare": "husky"
	},
	"keywords": [
		"Typescript",
		"React",
		"Redux",
		"Spotify"
	],
	"license": "MIT",
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.0.0",
		"@fortawesome/free-solid-svg-icons": "^7.0.0",
		"@fortawesome/react-fontawesome": "^0.2.2",
		"classnames": "^2.5.1",
		"firebase": "^11.6.1",
		"history": "^5.3.0",
		"localforage": "^1.10.0",
		"lodash": "^4.17.21",
		"memoizee": "^0.4.17",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-redux": "^9.2.0",
		"react-router": "^6.30.0",
		"react-router-dom": "^6.30.0",
		"react-spring": "^10.0.3",
		"redux": "^5.0.1",
		"redux-first-history": "^5.2.0",
		"redux-persist": "^6.0.0",
		"redux-saga": "^1.3.0",
		"tailwindcss": "^3.4.17",
		"typed-redux-saga": "^1.5.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@eslint/js": "^9.17.0",
		"@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
		"@stylistic/eslint-plugin": "^2.13.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/lodash": "^4.17.14",
		"@types/memoizee": "^0.4.11",
		"@types/node": "^22.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/spotify-api": "^0.0.25",
		"@types/spotify-web-playback-sdk": "^0.1.19",
		"@types/webpack-env": "^1.18.5",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^2.1.8",
		"autoprefixer": "^10.4.20",
		"css-loader": "^7.1.2",
		"eslint": "^9.17.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"firebase-tools": "^14.2.1",
		"globals": "^15.14.0",
		"html-webpack-plugin": "^5.6.3",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"mini-css-extract-plugin": "^2.9.2",
		"postcss": "^8.4.49",
		"postcss-loader": "^8.1.1",
		"prettier": "^3.4.2",
		"react-refresh": "^0.14.2",
		"react-refresh-typescript": "^2.0.10",
		"sass": "^1.83.0",
		"sass-loader": "^16.0.4",
		"semantic-release": "^24.2.0",
		"style-loader": "^4.0.0",
		"stylelint": "^16.12.0",
		"stylelint-config-recommended-scss": "^14.1.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"stylelint-scss": "^6.10.0",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.0",
		"vite": "^6.0.5",
		"vitest": "^2.1.8",
		"webpack": "^5.97.1",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.2.0",
		"workbox-webpack-plugin": "^7.3.0"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"commitlint": {
		"parserPreset": "conventional-changelog-conventionalcommits",
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"packageManager": "yarn@4.7.0"
}
