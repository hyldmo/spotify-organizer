{
	"compilerOptions": {
		"outDir": "./dist/",
		"sourceMap": true,
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2020",
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		},
		"skipLibCheck": true
	},
	"files": [
		"./src/types/globals.ts",
		"./src/vite-env.d.ts",
		"./node_modules/@types/spotify-api/index.d.ts",
		"./node_modules/@types/spotify-web-playback-sdk/index.d.ts"
	],
	"include": ["src/**/*", "vite.config.ts"]
}
